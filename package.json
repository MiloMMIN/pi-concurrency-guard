{
  "name": "pi-concurrency-guard",
  "version": "1.0.0",
  "description": "Zero-residue multi-agent concurrency hang watchdog & safe guard for Pi Coding Agent",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "link": "node scripts/setup-link.mjs",
    "sync": "node scripts/sync.mjs patch",
    "sync:minor": "node scripts/sync.mjs minor",
    "sync:major": "node scripts/sync.mjs major",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "concurrency",
    "watchdog",
    "concurrency-guard",
    "hang-guard"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "MiloMMIN",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
